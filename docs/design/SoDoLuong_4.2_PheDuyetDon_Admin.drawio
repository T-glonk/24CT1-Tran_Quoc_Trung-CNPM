        <mxCell id="e14" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="diamond1" target="diamond2">
          <mxGeometry relative="1" as="geometry"/>
