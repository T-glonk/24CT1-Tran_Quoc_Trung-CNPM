        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;dashed=1;entryX=0.5;entryY=0;exitX=0;exitY=0.5;" edge="1" parent="1" source="cancel_box" target="step3">
          <mxGeometry relative="1" as="geometry"/>
