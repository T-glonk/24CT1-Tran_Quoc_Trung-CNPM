        <mxCell id="e5" value="Hủy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="step4" target="cancel_box">
          <mxGeometry relative="1" as="geometry"/>
