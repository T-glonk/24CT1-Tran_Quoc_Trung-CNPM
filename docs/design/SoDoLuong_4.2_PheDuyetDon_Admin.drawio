<mxfile host="app.diagrams.net" modified="2026-10-28T14:00:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram name="4.2_PheDuyetDon" id="phe_duyet_don_admin">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="4.2 THIẾT KẾ PHẦN MỀM - CHỨC NĂNG PHÊ DUYỆT ĐƠN ĐẶT SÂN ADMIN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="START" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;Mở web/app &amp;amp; Đăng nhập&lt;/b&gt;&lt;br&gt;Đăng nhập Quản trị viên&lt;br&gt;http://localhost:5000&lt;br&gt;Tài khoản role &#39;Admin&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="185" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;Mở trang Quản lý Đặt sân&lt;/b&gt;&lt;br&gt;tab #bookings-page&lt;br&gt;GET /api/bookings?status=pending&lt;br&gt;Tải danh sách đơn chờ duyệt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="185" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;Xem chi tiết &amp;amp; Chọn đơn&lt;/b&gt;&lt;br&gt;Mã đơn, Tên khách, SĐT,&lt;br&gt;Sân đấu, Khung giờ, Tiền cọc&lt;br&gt;Trạng thái &#39;Pending&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="185" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;Chọn hành động xử lý&lt;/b&gt;&lt;br&gt;Bấm nút [Duyệt đơn] hoặc&lt;br&gt;bấm nút [Hủy đơn]&lt;br&gt;onUpdateStatus(id, action)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="185" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cancel_box" value="&lt;b&gt;Hủy thao tác&lt;/b&gt;&lt;br&gt;Đóng hộp thoại&lt;br&gt;Giữ nguyên danh sách đơn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="60" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;Nhập ghi chú quyết định&lt;/b&gt;&lt;br&gt;Mở Modal xác nhận / ghi chú&lt;br&gt;Ghi chú duyệt / Lý do hủy đơn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="185" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step6" value="&lt;b&gt;Xác nhận thao tác?&lt;/b&gt;&lt;br&gt;Bấm nút Xác nhận (OK)&lt;br&gt;(Không bấm nút Hủy)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="185" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step7" value="&lt;b&gt;Gửi yêu cầu xử lý&lt;/b&gt;&lt;br&gt;PATCH /api/bookings/:id/status&lt;br&gt;updateBookingStatus() /&lt;br&gt;cancelBooking()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1490" y="185" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="diamond1" value="&lt;b&gt;Đơn hợp lệ trong CSDL?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;SELECT id FROM bookings&lt;br&gt;WHERE id = %s&lt;br&gt;&amp;amp; status = &#39;pending&#39;&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1710" y="170" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="fail_box" value="&lt;b&gt;Xử lý thất bại&lt;/b&gt;&lt;br&gt;Đơn đã duyệt trước đó hoặc lỗi CSDL&lt;br&gt;HTTP 400/404, Hiển thị Alert báo lỗi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1700" y="340" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="diamond2" value="&lt;b&gt;Quyết định là Phê duyệt?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;action == &#39;confirmed&#39;&lt;br&gt;hay action == &#39;cancelled&#39;&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1930" y="170" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="success_approve" value="&lt;b&gt;Phê duyệt thành công&lt;/b&gt;&lt;br&gt;UPDATE bookings status = &#39;confirmed&#39;&lt;br&gt;UPDATE courts status = &#39;in_use&#39;&lt;br&gt;Ghi sổ quỹ transactions&lt;br&gt;HTTP 200, Đổi huy hiệu &#39;Confirmed&#39;&lt;br&gt;loadBookingsList()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2150" y="110" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="success_reject" value="&lt;b&gt;Từ chối / Hủy đơn thành công&lt;/b&gt;&lt;br&gt;UPDATE bookings status = &#39;cancelled&#39;&lt;br&gt;Ghi nhận lý do hủy vào field &#39;note&#39;&lt;br&gt;Giải phóng slot sân về &#39;available&#39;&lt;br&gt;HTTP 200, Đổi huy hiệu &#39;Cancelled&#39;&lt;br&gt;loadBookingsList()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2150" y="250" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="start" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
