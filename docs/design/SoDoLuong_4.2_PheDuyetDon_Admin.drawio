        <mxCell id="e9" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;entryX=1;entryY=0.5;exitX=0.5;exitY=0;" edge="1" parent="1" source="step6" target="cancel_box">
          <mxGeometry relative="1" as="geometry"/>
