        <mxCell id="e11" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="diamond2" target="diamond3">
          <mxGeometry relative="1" as="geometry"/>
