        <mxCell id="e6" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="diamond1" target="fail_valid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="Nhập lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;dashed=1;entryX=0.5;entryY=1;exitX=0;exitY=0.5;" edge="1" parent="1" source="fail_valid" target="step4">
          <mxGeometry relative="1" as="geometry">
