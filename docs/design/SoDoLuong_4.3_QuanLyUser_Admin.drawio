        <mxCell id="e13" value="Chỉnh sửa lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;dashed=1;entryX=0.25;entryY=1;exitX=0;exitY=0.5;" edge="1" parent="1" source="fail_auth" target="step4">
