<mxfile host="app.diagrams.net" modified="2026-10-28T14:00:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram name="4.3_QuanLyUser" id="quan_ly_user_admin">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="4.3 THIẾT KẾ PHẦN MỀM - CHỨC NĂNG QUẢN LÝ VÀ PHÂN QUYỀN NGƯỜI DÙNG ADMIN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="750" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="START" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="80" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;Mở web/app &amp;amp; Đăng nhập&lt;/b&gt;&lt;br&gt;Đăng nhập Quản trị viên&lt;br&gt;http://localhost:5000&lt;br&gt;Tài khoản role &#39;Admin&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="145" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;Mở trang Quản lý User&lt;/b&gt;&lt;br&gt;tab AdminUsersScreen&lt;br&gt;GET /api/users/ hoặc /api/customers/&lt;br&gt;Tải danh sách tài khoản hệ thống" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="145" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;Chọn tài khoản cần sửa&lt;/b&gt;&lt;br&gt;Bấm nút &#39;Sửa&#39; trên danh sách&lt;br&gt;Mở Modal #editUserModal&lt;br&gt;Đổ dữ liệu tài khoản lên form" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="145" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;Chỉnh sửa thông tin &amp;amp; quyền&lt;/b&gt;&lt;br&gt;Họ tên, SĐT, Email, Mật khẩu mới&lt;br&gt;Vai trò: Admin / Manager / Staff&lt;br&gt;Trạng thái: Hoạt động / Tạm khóa&lt;br&gt;Cụm cơ sở sân phụ trách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="605" y="280" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="diamond1" value="&lt;b&gt;Dữ liệu nhập hợp lệ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Có tên &amp;amp; SĐT đúng 10 số&lt;br&gt;Mật khẩu mới ≥ 6 ký tự&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="855" y="275" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fail_valid" value="&lt;b&gt;Dữ liệu không hợp lệ&lt;/b&gt;&lt;br&gt;Hiển thị Alert cảnh báo lỗi&lt;br&gt;Giữ nguyên modal để nhập lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="845" y="440" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;Gửi yêu cầu cập nhật&lt;/b&gt;&lt;br&gt;PUT /api/users/:id/update&lt;br&gt;onUpdateUserRole() / updateUser()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1075" y="285" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="diamond2" value="&lt;b&gt;Thẩm quyền Admin hợp lệ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;req.user.role == &#39;admin&#39;&lt;br&gt;(JWT Token hợp lệ)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1300" y="275" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="diamond3" value="&lt;b&gt;Tài khoản tồn tại trong DB?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;SELECT id FROM users&lt;br&gt;WHERE id = %s&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1515" y="275" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fail_auth" value="&lt;b&gt;Cập nhật thất bại&lt;/b&gt;&lt;br&gt;Không có quyền hoặc không tìm thấy ID&lt;br&gt;HTTP 401/403/404, Alert báo lỗi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="440" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="step6" value="&lt;b&gt;Cập nhật CSDL đa bảng&lt;/b&gt;&lt;br&gt;UPDATE users (role, status, phone...)&lt;br&gt;Đồng bộ bảng customers&lt;br&gt;Đồng bộ ca trực nhân viên&lt;br&gt;Ghi nhật ký activity_logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1730" y="280" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="step7" value="&lt;b&gt;Cập nhật thành công&lt;/b&gt;&lt;br&gt;Commit Transaction CSDL MySQL&lt;br&gt;HTTP 200, Alert/Toast báo thành công&lt;br&gt;Đóng modal &amp;amp; Tải lại danh sách&lt;br&gt;loadUsersList()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1975" y="280" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="start" target="step1">
          <mxGeometry relative="1" as="geometry"/>
